{
  "version": 2,
  "buildCommand": "cd ../.. && pnpm --filter shared build && cd apps/api && pnpm install --frozen-lockfile && pnpm run build",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", "prisma/**", "dist/**", "../../packages/shared/dist/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
