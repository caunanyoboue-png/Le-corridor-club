# ── Base de données ─────────────────────────────────────────────────
POSTGRES_USER=maquis
POSTGRES_PASSWORD=maquis_secret
POSTGRES_DB=maquis_dev
DATABASE_URL="postgresql://maquis:maquis_secret@localhost:5432/maquis_dev"

# ── JWT ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── API ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=https://le-corridor-club-web.vercel.app
# ── Mail (Nodemailer – stub) ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@lecorridorclub.ci
SMTP_PASS=smtp_password

# ── Web ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
